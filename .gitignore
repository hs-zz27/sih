# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Editors / OS ---
.vscode/
.idea/
*.swp
.DS_Store

# --- Local secrets / machine-specific config ---
.env
config.local.yaml

# --- Runtime artefacts (never commit generated output) ---
data/uploads/*
data/downloads/*
data/index/*
!data/uploads/.gitkeep
!data/downloads/.gitkeep
!data/index/.gitkeep

# Audit logs are evidence, but they are regenerated every run.
logs/
*.log

# --- Model weights: pulled once, never tracked in git ---
models/
*.gguf
*.safetensors
*.bin
*.onnx

# The demo corpus IS tracked (see data/corpus) - it is part of the submission.

# --- Local scratch: corpus-generation helpers, never committed ---
local/
